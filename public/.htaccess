# ============================================================
# mshsounds.co.za — Apache config for the static Next.js export
# ============================================================

RewriteEngine On

# Don't let mod_dir 301 "/gallery" -> "/gallery/" before the rewrite below
# gets a chance to serve gallery.html (keeps the sitemap/canonical URL exact).
DirectorySlash Off

# --- Canonical host + HTTPS (single pass, no redirect chains) ---
# www.mshsounds.co.za (or any other host) and plain HTTP both 301 to
# https://mshsounds.co.za — matches metadataBase and sitemap.xml.
RewriteCond %{HTTP_HOST} !^mshsounds\.co\.za$ [OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://mshsounds.co.za/$1 [R=301,L]

# --- Pretty URLs ---
# /gallery maps to the physical /gallery image folder (no index file),
# so it must be rewritten explicitly BEFORE the generic rule below.
RewriteRule ^gallery/?$ gallery.html [L]

# /about -> about.html etc. (static export emits <page>.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# --- Custom 404 ---
ErrorDocument 404 /404.html

# --- No directory listings (gallery folders hold raw image files) ---
Options -Indexes

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Browser caching ---
# Hashed build assets and media are safe to cache hard; HTML must stay fresh
# so releases show up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
